# Подключение к PostgreSQL. Драйвер asyncpg обязателен:
# `postgresql://` блокирует event loop в async-контексте (CLAUDE.md "What NOT to Use").
DATABASE_URL=postgresql+asyncpg://novryn:novryn@localhost:5432/novryn

# Часовой пояс пользователя (IANA-имя): в нём считается «сегодня» для фокуса дня.
# По умолчанию UTC.
NOVRYN_TIMEZONE=Europe/Moscow
